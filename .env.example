# ==== Backend ====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=*

# Anadir usuario admin de prueba al arrancar
SEED_ADMIN=true

# ==== Base de datos ====
# En docker-compose el host es "db"
DATABASE_URL=postgresql+psycopg2://appuser:apppass@db:5432/appdb

# ==== Azure Blob / Azurite ====
# Cadena de conexion de Azurite (entorno local, NO usar en produccion)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
AZURE_STORAGE_CONTAINER=files
BLOB_VERSIONING=true

# ==== Frontend ====
API_BASE=http://backend:8000
# true = UI con datos falsos, sin depender del backend (util al principio)
USE_MOCK=false
